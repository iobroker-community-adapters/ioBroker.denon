{
  "name": "iobroker.denon",
  "version": "1.15.12",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "ioBroker DENON/Marantz Adapter",
  "author": "Moritz Heusinger <moritz.heusinger@gmail.com>",
  "contributors": [
    "Moritz Heusinger <moritz.heusinger@gmail.com>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.denon",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "denon",
    "marantz",
    "avr",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iobroker-community-adapters/ioBroker.denon.git"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@iobroker/testing": "^6.3.2",
    "@iobroker/types": "^7.2.5",
    "@typescript-eslint/eslint-plugin": "^5.48.0",
    "@typescript-eslint/parser": "^5.48.0",
    "axios": "^1.7.2",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "gulp": "^4.0.2",
    "prettier": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4"
  },
  "main": "build/main.js",
  "scripts": {
    "prebuild": "rimraf ./build",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts",
    "check": "tsc --noEmit",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:package",
    "lint": "eslint src/",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.denon/issues"
  },
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*).json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "io-package.json",
    "build/main.js",
    "build/lib",
    "LICENSE"
  ]
}
